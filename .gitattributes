# 跨平台换行规则(AGENTS.md「跨平台开发规则」,任务 #135)
# 文本文件在仓库和各系统的工作区里统一使用 LF。
* text=auto eol=lf

# 明确按文本处理(LF)
*.md text eol=lf
*.json text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.asset text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.ts text eol=lf
*.html text eol=lf

# Windows 批处理与 PowerShell 脚本按平台惯例使用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件,不做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.fbx binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.onnx binary
*.pdf binary
*.zip binary
*.dll binary
*.so binary
*.dylib binary
*.a binary
